{
  "name": "amanat-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "demo:reset": "tsx --conditions=react-server scripts/seed.ts --reset",
    "ml:generate": "python ml/generate.py --seed 2026",
    "ml:train": "python ml/train.py",
    "db:local": "tsx scripts/local-db.ts",
    "test:e2e": "playwright test",
    "stt:bakeoff": "tsx --conditions=react-server scripts/stt-bakeoff.ts",
    "voice:generate": "tsx scripts/voice/generate-clips.ts",
    "test:summary": "tsx scripts/test-summary.ts",
    "warmup": "tsx scripts/warmup.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "demo:twice": "pnpm demo:reset && pnpm test:e2e && pnpm demo:reset && pnpm test:e2e"
  },
  "dependencies": {
    "@ai-sdk/elevenlabs": "^3.0.87",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/nextjs": "^11.15.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "ai": "7.0.178",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "inngest": "4.26.2",
    "jose": "^6.2.18",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-pgvector": "^0.0.18",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
