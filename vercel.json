{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "regions": [
    "bom1"
  ],
  "functions": {
    "app/api/**/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/anchor",
      "schedule": "0 22 * * *"
    }
  ]
}
