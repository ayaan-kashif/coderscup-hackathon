# Copy to .env.local. Never commit real values. Every value below is a secret or deployment setting.
# Postgres (Supabase, Mumbai). Pooled URL (port 6543, transaction mode) for the app; direct URL for migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=
# HS256 secret used to sign 15-minute access tokens (min 32 chars). Use the Supabase legacy JWT secret if you want auth.uid() in RLS policies.
AUTH_JWT_SECRET=
# AES-256-GCM key for CNIC and wallet numbers (base64, 32 bytes) and the HMAC pepper for lookups
PII_ENC_KEY=
PII_HMAC_PEPPER=
# Pepper for API key hashes
API_KEY_PEPPER=
# Upstash Redis for rate limits (optional locally: falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Mock document issuer Ed25519 private key (PKCS8 PEM, base64). Only the generator needs it; the app reads public keys from mock.issuer_keys.
MOCK_ISSUER_PRIVATE_KEY=
# Demo mode: enables POST /api/v1/demo/tokens and the role picker. Passwords and PINs for the fictional .test accounts.
DEMO_MODE=true
# Private code for demo sign-in. Required on Vercel (demo stays closed without it); optional locally.
# DEMO_ACCESS_CODE=choose-a-long-random-code
DEMO_STAFF_PASSWORD=
DEMO_CITIZEN_PIN=
# Base URL the mock adapters call (defaults to the request origin)
MOCK_BASE_URL=
# Optional
SENTRY_DSN=

# ---- Prompt 2: AI, jobs, speech (all optional: without them every model step takes its documented fallback) ----
# Vercel AI Gateway (Gemini 3.8 Flash, TypeSafe Jev, ElevenLabs Scribe). On Vercel, OIDC works without a key.
AI_GATEWAY_API_KEY=
# Inngest (case.process as durable steps). Unset → the pipeline runs inline after the response.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Fallback scheduler (Vercel Cron) for /api/cron/{outbox,anchor,retention,payments}; the route is closed when unset
CRON_SECRET=
# Uplift AI speech-to-text (not on the gateway). The URL was not verified against official docs; override if needed.
UPLIFT_API_KEY=
UPLIFT_STT_URL=

# Sentry (optional): server errors with request id and operation only, never bodies or personal data
SENTRY_DSN=
