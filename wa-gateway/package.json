{
  "name": "amanat-wa-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sends AMANAT sign-in codes through WhatsApp Web (Baileys). Runs on a laptop or always-on host, never on Vercel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "fake": "tsx src/fake.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
